# =============================================================================
# Root .gitignore for Vendor Performance Analytics
# =============================================================================

# Environment & Secrets (Never commit credentials)
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python virtual environments & interpreters
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python compiled bytecode & runtime caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# Node dependencies & package manager logs
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
dist-ssr/
build/
frontend/dist/

# Upload staging & temporary files
backend/uploads_temp/*
!backend/uploads_temp/.gitkeep
*.tmp
*.temp

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
