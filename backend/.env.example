# =============================================================================
# Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and supply your local or production credentials.
# NEVER commit the active .env file or real credentials to Git.

# Application Information
PROJECT_NAME=Vendor Performance Analytics
PORT=8000

# Database Connection (MySQL 8.0)
# Local: mysql+pymysql://root:<password>@localhost:3306/vendor_analytics_db?charset=utf8mb4
# Cloud (Render/Railway/Aiven/PlanetScale): mysql+pymysql://<user>:<password>@<cloud-host>:3306/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/vendor_analytics_db?charset=utf8mb4

# Authentication & Cryptographic Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of permitted frontend origins (e.g. Vercel deployment URL + localhost)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-service.vercel.app

# Optional Upload & Dataset File Paths
# In cloud container deployments, override with a mounted persistent volume or /tmp
# UPLOAD_DIR=/tmp/uploads_temp
# DATASET_DIR=/path/to/raw/dataset
